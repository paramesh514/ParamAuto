# Keystore Configuration Template for ParamAuto Release Signing
# Copy this file to "keystore.properties" (which is git-ignored) and fill in your actual credentials.
#
# To generate a new production release keystore, run:
#   keytool -genkeypair -v -keystore release.keystore -alias parampilot -keyalg RSA -keysize 2048 -validity 10000
#
# Alternatively, configure via environment variables:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storeFile=release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=parampilot
keyPassword=YOUR_KEY_PASSWORD

